<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_blue"
    android:padding="16dp">

    <!-- Top Rectangle (covers 75% of the screen height from the bottom to the top) -->
    <View
        android:id="@+id/top_rectangle"
        android:layout_width="418dp"
        android:layout_height="535dp"
        android:background="@drawable/white_rectangle__1_"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.75"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Notice Title Field inside Top Rectangle -->
    <EditText
        android:id="@+id/noticeTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter Notice Title"
        android:background="@drawable/username"
        android:textSize="16sp"
        android:inputType="text"
        app:layout_constraintTop_toTopOf="@id/top_rectangle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Notice Description Field inside Top Rectangle -->
    <EditText
        android:id="@+id/noticeDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter Notice Description"
        android:textSize="16sp"
        android:inputType="textMultiLine"
        android:background="@drawable/username"
        android:layout_marginTop="16dp"
        android:lines="4"
        app:layout_constraintTop_toBottomOf="@id/noticeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Notice Date Field (TextView instead of EditText) inside Top Rectangle -->
    <TextView
        android:id="@+id/noticeDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Select Notice Date"
        android:textSize="16sp"
        android:focusable="false"
        android:clickable="true"
        android:layout_marginTop="16dp"
        android:padding="10dp"
        android:background="@drawable/username"
        app:layout_constraintTop_toBottomOf="@id/noticeDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Post Notice Button inside Top Rectangle -->
    <Button
        android:id="@+id/postNoticeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Post Notice"
        android:background="@color/navy_blue"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/noticeDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toBottomOf="@id/top_rectangle" />

</androidx.constraintlayout.widget.ConstraintLayout>
